<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_urlbar"
                android:hint="Cari atau ketik alamat"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A93AD"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnShield"
                style="@style/BarIcon"
                android:contentDescription="Anti iklan"
                android:src="@drawable/ic_shield" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="invisible" />

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/BarIcon"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btnForward"
                style="@style/BarIcon"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="Maju"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/btnReload"
                style="@style/BarIcon"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="Muat ulang"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/btnTranslate"
                style="@style/BarIcon"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="Terjemahkan gambar di halaman"
                android:src="@drawable/ic_translate" />

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/BarIcon"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="Menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/customContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
